# Core settings
APP_ENV=development
APP_NAME="Claim What's Yours API"
DATABASE_URL=sqlite:///./claim_whats_yours.db
ADMIN_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SCHEME_REVIEW_MAX_AGE_DAYS=180
RATE_LIMIT_PER_MINUTE=60

# Groq AI settings
# Enable Groq integration for natural-language understanding
GROQ_ENABLED=false
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# Three independent API key slots for failover
# Empty slots are ignored at startup
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Optional team labels (for observability only — never the key itself)
GROQ_TEAM_LABEL_1=slot-1
GROQ_TEAM_LABEL_2=slot-2
GROQ_TEAM_LABEL_3=slot-3

# Timing and retry configuration
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=4
GROQ_MAX_OUTPUT_TOKENS=2000

# Circuit breaker: open after N consecutive 5xx/network failures
GROQ_CIRCUIT_BREAKER_THRESHOLD=5
# Seconds the circuit stays open before allowing a probe request
GROQ_CIRCUIT_BREAKER_RESET_SECONDS=60

# Data sources
# data.gov.in integration (optional)
DATA_GOV_IN_ENABLED=false
DATA_GOV_IN_API_KEY=

# Notifications (optional)
NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
